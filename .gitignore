# ==============================================================================
# FLORVA — Root .gitignore
# MERN Monorepo (React + Vite Client & Express.js Server)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# Production Builds & Caches
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/
.cache/
**/.cache/
.vite/
**/.vite/
.parcel-cache/
.eslintcache

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
*.local
**/.env
**/.env.*
**/*.local

# Whitelist safe example environment templates
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDE, Editor & Assistant Local Workspace Files
# ------------------------------------------------------------------------------
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI Assistant & Local Generated Artifacts
.gemini/
**/.gemini/
.antigravity/
**/.antigravity/
.system_generated/
**/.system_generated/
